# ============================================================================
# DATA FILES
# ============================================================================

# Raw data (CSV, JSON, etc.) - Keep directory structure, ignore contents
data/raw/*
data/cleaned/*
data/processed/*
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/processed/.gitkeep

